# Copy thành .env (đã có trong .gitignore) rồi điền giá trị thật — KHÔNG commit .env.

# Postgres thật (Supabase project rfycppppjyvmddkulvhw). Lấy mật khẩu từ Supabase dashboard
# > Project Settings > Database. Không set biến này thì backend/database.py sẽ âm thầm rơi về
# postgresql://postgres:postgres@localhost:5432/vlearn (Postgres local rỗng, không phải Supabase).
DATABASE_URL=postgresql://postgres:<db-password>@db.rfycppppjyvmddkulvhw.supabase.co:5432/postgres

# Gemini API key — cần cho /chat (route + generate). Thiếu key: /chat trả 503, các endpoint khác vẫn chạy bình thường.
GEMINI_API_KEY=

# FPT Cloud chat completion — cần cho /chat streaming.
FPT_API_KEY=
FPT_API_URL=https://mkp-api.fptcloud.com/chat/completions
FPT_MODEL=GLM-5.2
